{
  "name": "sticky-notes-desktop",
  "version": "1.0.0",
  "description": "Sticky Notes Desktop Application",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder --publish=never"
  },
  "build": {
    "appId": "com.stickynotes.app",
    "productName": "Sticky Notes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!src/**/*",
      "!desktop/**/*",
      "!node_modules/**/*",
      "!**/*.md",
      "!package-lock.json",
      "!babel.config.json"
    ],
    "extraFiles": [
      {
        "from": "../src",
        "to": "src",
        "filter": ["**/*", "!**/*.js.map"]
      },
      {
        "from": "../index.html",
        "to": "index.html"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0"
  }
}
